  "item": [
    {
      "name": "ProductService",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{product_service_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health check responde 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear Producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Producto QA Postman\",\n  \"description\": \"Producto creado para pruebas de regresión\",\n  \"price\": 99.99,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{product_service_url}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Producto creado responde 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var product = pm.response.json();",
                  "pm.test(\"La respuesta contiene los datos esenciales del producto\", function () {",
                  "    pm.expect(product).to.have.property(\"id\").that.is.a(\"number\");",
                  "    pm.expect(product).to.include({ name: \"Producto QA Postman\", stock: 5 });",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"created_product_id\", product.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar Productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{product_service_url}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Listado de productos responde 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es paginada\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"items\").that.is.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
