        {
          "name": "Crear Orden Exitosa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"customer-qa-postman\",\n  \"items\": [\n    {\n      \"productId\": {{created_product_id}},\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{order_service_url}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Orden creada responde 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var order = pm.response.json();",
                  "pm.test(\"La respuesta contiene los datos esenciales de la orden\", function () {",
                  "    pm.expect(order).to.have.property(\"id\").that.is.a(\"number\");",
                  "    pm.expect(order).to.include({ customerId: \"customer-qa-postman\" });",
                  "    pm.expect(order).to.have.property(\"items\").that.is.an(\"array\").with.lengthOf(1);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"created_order_id\", order.id);"
                ]
              }
            }
          ]
        },
