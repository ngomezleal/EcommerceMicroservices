                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear Orden con Stock Insuficiente (Fallo 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"customer-qa-postman\",\n  \"items\": [\n    {\n      \"productId\": {{created_product_id}},\n      \"quantity\": 6\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{order_service_url}}/api/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Stock insuficiente responde 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"La respuesta cumple RFC 7807\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    var problem = pm.response.json();",
                  "    pm.expect(problem).to.include({ status: 400, title: \"Validation failed.\", instance: \"/api/orders\" });",
                  "    pm.expect(problem.detail).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
